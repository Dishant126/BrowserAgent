{
  "manifest_version": 3,
  "name": "PrivSight — Privacy-Preserving Browser Agent",
  "version": "2.0.0",
  "description": "PrivSight: local visual perception + local privacy protection + remote AI reasoning. Supports Wikipedia, Books to Scrape, Quotes to Scrape, and a controlled demo benchmark.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "offscreen",
    "alarms",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*",
    "https://en.wikipedia.org/*",
    "https://www.wikipedia.org/*",
    "https://*.yatra.com/*",
    "https://*.makemytrip.com/*",
    "https://*.ilovepdf.com/*",
    "https://*.irctc.co.in/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Agent"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",
        "models/*",
        "tesseract/*",
        "ort-wasm/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "commands": {
    "toggle-floating-panel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle PrivSight Floating Panel"
    }
  }
}
